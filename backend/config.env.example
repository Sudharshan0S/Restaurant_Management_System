# Copy this file to config.env and fill in the values (on Vercel/Render add them as Environment Variables instead).
MONGO_URI=mongodb://127.0.0.1:27017/Restaurant
PORT=5000
# Your website address(es), comma separated. Leave empty to allow any origin.
FRONTEND_URL=http://localhost:5173
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- Admin account (created automatically on first start) ----
# Local development works without these (falls back to admin@gmail.com / admin123).
# In production you MUST set both, otherwise no admin account exists. Use a strong password!
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

RESTAURANT_NAME=Indian Restaurant

# ---- Email confirmations (any SMTP provider: Gmail app password, Brevo, Mailtrap, ...) ----
# Leave blank to disable. The app will then report "email service not configured".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# EMAIL_SECURE=false   (true for port 465)

# ---- SMS (optional, Twilio) ----
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=+91
